{
  "compilerOptions": {
    "target": "es2020",
		"module": "umd",
		"moduleResolution": "node",
		"ignoreDeprecations": "6.0",
    "removeComments": true,
    "declaration": true,
    "preserveConstEnums": true,
    "rootDir": "./src",
    "outDir": "lib/umd",
    "sourceMap": true,
    "allowJs": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noImplicitReturns": true,
    "stripInternal": true,
    "lib": [
			"es2020"
		]
  },
  "include": [
    "src/**/*.ts"
  ]
}
