{
  "name": "@paul80nd/rcasm",
  "version": "1.21.0",
  "description": "Relay Computer Assembler",
  "keywords": [
    "assembler",
    "assembly",
    "relay-computer",
    "rcasm"
  ],
  "main": "./lib/umd/index.js",
  "typings": "./lib/umd/index",
  "module": "./lib/esm/index.js",
  "files": [
    "/lib/esm",
    "/lib/umd"
  ],
  "engines": {
    "node": ">=24"
  },
  "author": "Paul Law",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paul80nd/rcasm.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "prepublishOnly": "npm run clean && npm run compile && npm run compile-esm && npm run compile-tst && npm run test",
    "compile": "tsc -p . && npm run lint",
    "compile-esm": "tsc -p ./tsconfig.esm.json",
    "compile-tst": "tsc -p ./tsconfig.test.json",
    "clean": "rimraf lib",
    "gen": "npx peggy -o src/g_parser.js --format es src/parser.pegjs",
    "test": "npm run compile-tst && mocha --parallel",
    "lint": "eslint .",
    "watch": "tsc --watch -p ."
  },
  "dependencies": {
    "typedfastbitset": "^0.8.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "glob": "13.0.6",
    "mocha": "11.8.0",
    "peggy": "5.1.0",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  }
}
